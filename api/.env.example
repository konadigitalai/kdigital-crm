# Copy to .env and fill in. NEVER commit .env (or this file with a real password).
# Azure Postgres Flexible Server — sslmode=require is mandatory.
DATABASE_URL=postgres://decrm_admin:YOUR_ADMIN_PASSWORD@de-crm-pg.postgres.database.azure.com:5432/postgres?sslmode=require

# Non-superuser, NOBYPASSRLS app role — created by post-0006 migration.
# The API connects as this role (RLS enforced); migrations + seed use the admin URL above.
DECRM_APP_PASSWORD=YOUR_APP_PASSWORD
APP_DATABASE_URL=postgres://decrm_app:YOUR_APP_PASSWORD@de-crm-pg.postgres.database.azure.com:5432/postgres?sslmode=require

# Express
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Public URL of the web app — used when the API builds deep-links into the
# CRM (e.g. "View in CRM" buttons in Slack notifications). Dev default is
# http://localhost:3000 if unset; in prod set to the Vercel domain.
WEB_APP_URL=http://localhost:3000

# For local docker-compose Postgres (override DATABASE_URL when working offline):
# DATABASE_URL=postgres://decrm:decrm@localhost:5433/decrm

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Single Auth0 tenant shared across local/dev/qa/prod. The API verifies every
# incoming JWT against this issuer + audience, and reads the permissions
# claim that the post-login Action injects.
AUTH0_DOMAIN=YOUR_TENANT.region.auth0.com
AUTH0_AUDIENCE=https://api.digitaledify.com
# The custom claim the post-login Action sets — must match exactly. Don't
# change without also updating the Action in the Auth0 dashboard.
AUTH0_PERMISSIONS_CLAIM=https://digitaledify.com/permissions

# ─── Gmail (two-way email) ───────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). The consent screen must be set to "Internal" so it's
# restricted to our Workspace and skips Google's app-verification review.
#
# Enable the Gmail API on the project first. Scopes requested:
#   gmail.modify (read + label), gmail.send, openid, email
#
# The redirect URI must match a URI registered on the OAuth client EXACTLY —
# a mismatch produces "Error 400: redirect_uri_mismatch".
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Any long random string. Signs the OAuth `state` param so the public callback
# can't be forged. Same role as SLACK_STATE_SECRET. Must be identical across
# any environments that share an OAuth client.
GOOGLE_STATE_SECRET=change-me-to-a-long-random-string

# Fallback mailbox used when the sending advisor hasn't connected their own
# Gmail. An admin connects it once via the normal "Connect Gmail" flow; the
# account is flagged is_shared because its address matches this value.
GMAIL_SHARED_ACCOUNT_EMAIL=support@digitaledify.ai
# Our own domain. Two jobs: reject connecting a personal @gmail.com mailbox,
# and identify which participant on a thread is the external one (the lead).
GMAIL_INTERNAL_DOMAIN=digitaledify.ai
# How much of the mailbox flows into the CRM.
#   known_contacts (default) — only mail with someone already in the CRM. Mail
#     from a stranger is ignored and NO party is created for them.
#   all — also ingest mail from unknown senders, creating a stub party + an
#     unlinked thread you can promote to a lead. Use if you want the inbox to
#     catch cold inbound enquiries.
# Be careful with `all`: on a real mailbox it invented 31 parties (Slack,
# Vimeo, OpenAI, Facebook…) out of 32 threads. The bulk filters below help,
# but known_contacts is the safe default.
# GMAIL_SYNC_MODE=all

# Set to 1 to ALSO ingest bulk/automated mail. Off by default, which drops:
# Gmail's Promotions/Social/Updates/Forums categories, senders that look like
# robots (noreply@, do-not-reply@, notifications@…), and anything carrying a
# List-Unsubscribe header. CATEGORY_UPDATES is the big one — it's where Gmail
# files password resets, receipts and "someone joined your workspace".
# GMAIL_SYNC_BULK=1

# ─── Twilio (SMS + WhatsApp) ─────────────────────────────────────────────────
# See api/README.md → "Twilio — local testing" for the full end-to-end setup
# with ngrok. Required for /twilio/send + /webhooks/twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/webhooks/twilio

# ─── Vercel Blob (media attachments) ─────────────────────────────────────────
# Storage for files attached to Twilio messages + shared library.
# Backend-only token — the web bundle uses short-lived per-upload client
# tokens minted by the API.
#
# Setup: Vercel dashboard → Storage → Blob → create store → mark PUBLIC
# (Twilio needs to fetch by URL) → copy the token below.
# See api/README.md → "Media attachments" for the full flow.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX
