# Copy to .env and fill in. NEVER commit .env (or this file with a real password).
# Azure Postgres Flexible Server — sslmode=require is mandatory.
DATABASE_URL=postgres://decrm_admin:YOUR_ADMIN_PASSWORD@de-crm-pg.postgres.database.azure.com:5432/postgres?sslmode=require

# Non-superuser, NOBYPASSRLS app role — created by post-0006 migration.
# The API connects as this role (RLS enforced); migrations + seed use the admin URL above.
DECRM_APP_PASSWORD=YOUR_APP_PASSWORD
APP_DATABASE_URL=postgres://decrm_app:YOUR_APP_PASSWORD@de-crm-pg.postgres.database.azure.com:5432/postgres?sslmode=require

# Express
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Public URL of the web app — used when the API builds deep-links into the
# CRM (e.g. "View in CRM" buttons in Slack notifications). Dev default is
# http://localhost:3000 if unset; in prod set to the Vercel domain.
WEB_APP_URL=http://localhost:3000

# For local docker-compose Postgres (override DATABASE_URL when working offline):
# DATABASE_URL=postgres://decrm:decrm@localhost:5433/decrm

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Single Auth0 tenant shared across local/dev/qa/prod. The API verifies every
# incoming JWT against this issuer + audience, and reads the permissions
# claim that the post-login Action injects.
AUTH0_DOMAIN=YOUR_TENANT.region.auth0.com
AUTH0_AUDIENCE=https://api.digitaledify.com
# The custom claim the post-login Action sets — must match exactly. Don't
# change without also updating the Action in the Auth0 dashboard.
AUTH0_PERMISSIONS_CLAIM=https://digitaledify.com/permissions

# ─── Twilio (SMS + WhatsApp) ─────────────────────────────────────────────────
# See api/README.md → "Twilio — local testing" for the full end-to-end setup
# with ngrok. Required for /twilio/send + /webhooks/twilio.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/webhooks/twilio

# ─── Vercel Blob (media attachments) ─────────────────────────────────────────
# Storage for files attached to Twilio messages + shared library.
# Backend-only token — the web bundle uses short-lived per-upload client
# tokens minted by the API.
#
# Setup: Vercel dashboard → Storage → Blob → create store → mark PUBLIC
# (Twilio needs to fetch by URL) → copy the token below.
# See api/README.md → "Media attachments" for the full flow.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX
