# Copy to .env.local and fill in. NEVER commit .env.local.
#
# This is now the ONLY env file in the repo. The API used to be a separate
# Express service with its own api/.env; it runs inside this app now, so its
# variables live here too.
#
# Gone on purpose: API_URL / NEXT_PUBLIC_API_URL (the API is same-origin at
# /api, so there is nothing to point at) and PORT (that was Express's listen
# port; `next dev` uses 3000).

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Used by @auth0/nextjs-auth0. The SDK creates /auth/login, /auth/logout,
# /auth/callback, and /auth/profile routes automatically. Allowed Callback
# URL in Auth0 must include http://localhost:3000/auth/callback for local.

# Tenant base URL — the issuer of every token.
AUTH0_DOMAIN=YOUR_TENANT.region.auth0.com
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.region.auth0.com

# Single Page / Regular Web application client credentials from
# Auth0 → Applications → Edify Agentic OS → Settings.
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET

# The API audience — must match the API Identifier you set in
# Auth0 → Applications → APIs → Edify CRM API. Tokens issued to this
# audience contain the user's permissions.
AUTH0_AUDIENCE=https://api.digitaledify.com

# Public base URL of THIS web app (used by Auth0 SDK when constructing
# callback/logout URLs). Local: http://localhost:3000. Vercel: the
# environment's full https://<host>.vercel.app URL.
APP_BASE_URL=http://localhost:3000

# 32-byte random secret used to encrypt the SDK's session cookie. Generate
# with `openssl rand -hex 32`. Different per environment is ideal but a
# single shared secret is acceptable.
AUTH0_SECRET=YOUR_32_BYTE_HEX_SECRET

# The permissions claim the API reads off the access token. Optional — this
# is the built-in default.
AUTH0_PERMISSIONS_CLAIM=https://digitaledify.com/permissions

# ─── Database ────────────────────────────────────────────────────────────────
# Two roles, deliberately. APP_DATABASE_URL is what every request handler uses:
# decrm_app is NOBYPASSRLS, so row-level security enforces tenant isolation
# even if a query forgets a WHERE clause. DATABASE_URL is the admin role and is
# used ONLY by the migration runner and the LangGraph checkpointer.
#
# In production point APP_DATABASE_URL at PgBouncer (port 6432, not 5432).
# Each serverless invocation has its own pool, so a pooler is what keeps
# `concurrent invocations × DB_POOL_MAX` from exhausting Postgres. See DEPLOY.md.
# Port 6432 = PgBouncer (General Purpose tier only). On Burstable use 5432.
APP_DATABASE_URL=postgres://decrm_app:PASSWORD@localhost:5433/decrm
DATABASE_URL=postgres://decrm:decrm@localhost:5433/decrm
DECRM_APP_PASSWORD=PASSWORD

# Per-invocation pool size. Small on purpose — total connections reaching
# Postgres is `concurrent invocations x DB_POOL_MAX`. This deployment's
# Burstable B1ms caps near 35 connections and has no built-in PgBouncer,
# so keep this low. See DEPLOY.md.
DB_POOL_MAX=2

# Pins the tenant instead of "most recently created row wins".
DEFAULT_TENANT_ID=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <secret>` to /api/cron/*.
# The cron routes FAIL CLOSED without it: they dispatch paid WhatsApp/SMS
# sends, so an unauthenticated endpoint is not an acceptable default.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=YOUR_32_BYTE_HEX_SECRET

# ─── Public lead intake ──────────────────────────────────────────────────────
# Guards POST /api/leads/intake, the one unauthenticated write endpoint.
# Marketing pages send it as the X-Intake-Key header.
INTAKE_API_KEY=

# Origins allowed to call the intake endpoint cross-origin (marketing site, ad
# landing pages). Comma-separated. Everything else in the app is same-origin
# now, so this is far less load-bearing than it was.
CORS_ORIGIN=http://localhost:3000

# ─── Agents (Claude) ─────────────────────────────────────────────────────────
# Without these the agents pages still load, but agent RUNS throw.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Optional ────────────────────────────────────────────────────────────────
# Canonical origin for Server Component fetches. Defaults to VERCEL_URL in
# production and localhost otherwise; set this if you're on a custom domain.
# NEXT_PUBLIC_SITE_URL=https://crm.yourdomain.com

# Log any request slower than this (ms). Pairs with the Server-Timing header.
# SLOW_REQUEST_MS=1000

# ─── Gmail (two-way email) ───────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Consent screen set to "Internal" so it's restricted
# to our Workspace and skips Google's app-verification review. Enable the Gmail
# API first. Scopes: gmail.modify, gmail.send, openid, email.
#
# NOTE the redirect URI changed with the Express → Next.js migration: the API
# is served under /api now, so this is /api/auth/google/callback, not
# :4000/auth/google/callback. It must match a URI registered on the OAuth
# client EXACTLY or Google returns "Error 400: redirect_uri_mismatch".
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Any long random string. Signs the OAuth `state` param so the public callback
# can't be forged. Must be identical across environments sharing an OAuth client.
GOOGLE_STATE_SECRET=change-me-to-a-long-random-string

# Fallback mailbox used when the sending advisor hasn't connected their own
# Gmail. An admin connects it once via the normal "Connect Gmail" flow.
GMAIL_SHARED_ACCOUNT_EMAIL=support@digitaledify.ai
# Our own domain. Rejects connecting a personal @gmail.com mailbox, and
# identifies which participant on a thread is the external one (the lead).
GMAIL_INTERNAL_DOMAIN=digitaledify.ai
# How much of the mailbox flows into the CRM.
#   known_contacts (default) — only mail involving someone already in the CRM.
#   all — also ingest unknown senders, creating a stub party per thread.
# Careful with `all`: on a real mailbox it invented 31 parties (Slack, Vimeo,
# OpenAI, Facebook…) out of 32 threads.
# GMAIL_SYNC_MODE=all
# Set to 1 to ALSO ingest bulk/automated mail. Off by default, which drops
# Gmail's Promotions/Social/Updates/Forums categories, robot senders
# (noreply@, do-not-reply@…), and anything with a List-Unsubscribe header.
# GMAIL_SYNC_BULK=1

# ─── Twilio (SMS + WhatsApp) ─────────────────────────────────────────────────
# Required for /api/twilio/send and /webhooks/twilio.
#
# TWILIO_WEBHOOK_URL must match the URL configured in the Twilio console
# CHARACTER FOR CHARACTER — the inbound signature is an HMAC-SHA1 over the exact
# URL, so any mismatch fails every inbound message with a 403.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WEBHOOK_URL=https://your-ngrok-subdomain.ngrok-free.app/webhooks/twilio

# ─── Exotel (click-to-call) ──────────────────────────────────────────────────
# Required for POST /api/exotel/call. SID/key/token/virtual-number/webhook-base
# are all mandatory; the call endpoint returns 503 if any are missing.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=+91XXXXXXXXXX
# Base URL Exotel calls back on. With the migration this is the app's own
# origin — the /webhooks/* rewrite maps it onto the API.
EXOTEL_WEBHOOK_BASE_URL=https://your-app.vercel.app
# Defaults to api.in.exotel.com if unset.
# EXOTEL_SUBDOMAIN=api.in.exotel.com
# Comma-separated IP allowlist for the inbound webhook. Empty = allow all
# (dev-friendly). Read from x-forwarded-for, which Vercel sets.
# EXOTEL_ALLOWED_IPS=
# "Call desk" number rung when the advisor has no phone on their profile.
# EXOTEL_FALLBACK_AGENT_NUMBER=+91XXXXXXXXXX

# ─── Vercel Blob (media attachments) ─────────────────────────────────────────
# Storage for files attached to Twilio messages + the shared media library.
# Server-only token — the browser gets short-lived per-upload tokens minted by
# /api/media/upload-token. Store must be PUBLIC (Twilio fetches by URL).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX

# ─── Deep links ──────────────────────────────────────────────────────────────
# Used when the API builds "View in CRM" links (e.g. in Slack notifications).
WEB_APP_URL=http://localhost:3000

# ─── Tuning (all optional, defaults shown) ───────────────────────────────────
# DB_POOL_WAIT_WARN_MS=250            # warn when a pool slot takes this long
# SLOW_REQUEST_MS=1000                # log requests slower than this
# SLOW_FETCH_MS=1000                  # log Server Component fetches slower than this
# MAX_BODY_BYTES=6291456              # request body cap (6mb)
# CAMPAIGN_DISPATCH_BUDGET_MS=240000  # how long one dispatch invocation drains
# CAMPAIGN_STUCK_SENDING_MS=300000    # age before a 'sending' row is reaped
