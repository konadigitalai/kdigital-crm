# Copy to .env.local and fill in. NEVER commit .env.local.
#
# The Next.js web app expects API_URL on the server (Server Components +
# Route Handlers) and NEXT_PUBLIC_API_URL in the browser. They point at
# the same Express service.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Used by @auth0/nextjs-auth0. The SDK creates /auth/login, /auth/logout,
# /auth/callback, and /auth/profile routes automatically. Allowed Callback
# URL in Auth0 must include http://localhost:3000/auth/callback for local.

# Tenant base URL — the issuer of every token.
AUTH0_DOMAIN=YOUR_TENANT.region.auth0.com
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.region.auth0.com

# Single Page / Regular Web application client credentials from
# Auth0 → Applications → Edify Agentic OS → Settings.
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET

# The API audience — must match the API Identifier you set in
# Auth0 → Applications → APIs → Edify CRM API. Tokens issued to this
# audience contain the user's permissions.
AUTH0_AUDIENCE=https://api.digitaledify.com

# Public base URL of THIS web app (used by Auth0 SDK when constructing
# callback/logout URLs). Local: http://localhost:3000. Vercel: the
# environment's full https://<host>.vercel.app URL.
APP_BASE_URL=http://localhost:3000

# 32-byte random secret used to encrypt the SDK's session cookie. Generate
# with `openssl rand -hex 32`. Different per environment is ideal but a
# single shared secret is acceptable.
AUTH0_SECRET=YOUR_32_BYTE_HEX_SECRET
