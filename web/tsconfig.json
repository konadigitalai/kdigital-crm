{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Ops-only scripts, carried over from api/tsconfig.json's exclude list.
    // Run by hand via `npx tsx`, never reachable from the app, and their
    // optional deps (xlsx) are deliberately not installed.
    "src/server/db/_*.ts",
    "src/server/db/import-leads-xlsx.ts",
    "src/server/db/backfill-*.ts",
    "src/server/db/dump-and-wipe-leads.ts",
    "src/server/db/purge-soft-deleted-leads.ts"
  ]
}
